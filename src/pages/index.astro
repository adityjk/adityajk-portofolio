---
import Base from "@/layouts/Base.astro";
import Hero from "@/sections/Hero.astro";
import About from "@/sections/About.astro";
import SelectedWorks from "@/sections/SelectedWorks.astro";
import Footer from "@/sections/Footer.astro";

const title =
  "Aditya Jauhari Khazindar — Independent Web Developer, WordPress Dev";
const description =
  "Portfolio of Aditya Jauhari Khazindar, an independent web developer and WordPress developer.";
---

<Base title={title} description={description}>
  <main>
    <Hero />
    <About />
    <SelectedWorks />
  </main>
  <Footer />
</Base>
