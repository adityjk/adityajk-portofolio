---
import ThemeToggle from "@/components/ThemeToggle.astro";

const contact = {
	heading: "Let's work together.",
	email: "hello@adityajk.com",
	copyright: "© 2026 Aditya Jauhari Khazindar",
};

const socials = [
	{ name: "GitHub", url: "https://github.com/adityajk" },
	{ name: "LinkedIn", url: "https://linkedin.com/in/adityajk" },
];
---

<footer class="footer" id="contact">
	<div class="footer__bg" aria-hidden="true"></div>
	<div class="footer__panel">
		<div class="footer__content">
			<div class="footer__colophon">
				<span>Web Developer, WordPress Dev</span>
				<span>Semarang, Indonesia</span>
				<span class="footer__colophon-links">
					{socials.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
					))}
				</span>
			</div>

			<h2 class="footer__heading">{contact.heading}</h2>

			<div class="footer__icon" aria-hidden="true">
				<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25">
					<rect x="8" y="8" width="16" height="16" transform="rotate(45 16 16)" />
				</svg>
			</div>

			<div class="footer__contact">
				<a class="footer__email" href={`mailto:${contact.email}`}>
					{contact.email}
				</a>
				<div class="footer__bottom">
					<ul class="footer__socials">
						{
							socials.map((social) => (
								<li>
									<a href={social.url} target="_blank" rel="noopener noreferrer">
										{social.name}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<p class="footer__wordmark" data-wordmark>Aditya Jauhari K.</p>
			<p class="footer__closing">{contact.copyright}</p>
		</div>
	</div>
	<ThemeToggle class="footer__toggle" />
</footer>

<style>
	/* ---------- section: height set dynamically by JS for sticky reveal ---------- */
	.footer {
		position: relative;
	}

	/* ---------- blurred background layer (parallax, behind panel) ---------- */
	.footer__bg {
		position: absolute;
		inset: -10% 0;
		background:
			radial-gradient(
				ellipse 60% 50% at 50% 60%,
				color-mix(in srgb, var(--color-accent) 12%, transparent),
				transparent
			);
		filter: blur(60px);
		will-change: transform;
	}

	/* ---------- sticky window panel ---------- */
	.footer__panel {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	/* ---------- content: taller than viewport, scrolls through ---------- */
	.footer__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: 15vh;
		padding-inline: var(--container-pad);
		gap: var(--space-7);
		will-change: transform;
	}

	/* ---------- colophon row ---------- */
	.footer__colophon {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2) var(--space-5);
		font-family: var(--font-grotesk);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.footer__colophon a {
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--dur-base) ease;
	}

	.footer__colophon a:hover,
	.footer__colophon a:focus-visible {
		color: var(--color-accent);
	}

	.footer__colophon-links {
		display: flex;
		gap: var(--space-3);
	}

	.footer__colophon-links a::after {
		content: "/";
		margin-left: var(--space-3);
		color: var(--color-wash);
	}

	.footer__colophon-links a:last-child::after {
		content: "";
	}

	.footer__toggle {
		position: fixed;
		bottom: var(--space-5);
		right: var(--space-5);
		z-index: 10;
	}

	/* ---------- heading ---------- */
	.footer__heading {
		font-size: var(--text-2xl);
		font-weight: 500;
	}

	/* ---------- diamond icon — enlarged focal element ---------- */
	.footer__icon {
		width: clamp(5rem, 10vw, 7.5rem);
		height: clamp(5rem, 10vw, 7.5rem);
		color: var(--color-accent);
		will-change: transform;
	}

	.footer__icon svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* ---------- contact block ---------- */
	.footer__contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-6);
	}

	.footer__email {
		position: relative;
		font-size: var(--text-xl);
		color: var(--color-text);
		text-decoration: none;
	}

	.footer__email::after {
		content: "";
		position: absolute;
		left: 0;
		bottom: -0.1em;
		width: 100%;
		height: var(--line-thickness);
		background-color: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur-base) ease;
	}

	.footer__email:hover::after,
	.footer__email:focus-visible::after {
		transform: scaleX(1);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		align-items: center;
		justify-content: center;
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-wash);
	}

	.footer__socials {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer__socials a {
		font-family: var(--font-grotesk);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-muted);
		text-decoration: none;
		transition: color var(--dur-base) ease;
	}

	.footer__socials a:hover,
	.footer__socials a:focus-visible {
		color: var(--color-accent);
	}

	/* ---------- closing wordmark ---------- */
	.footer__wordmark {
		font-family: var(--font-serif);
		font-size: clamp(2.5rem, 15vw, 12rem);
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
		opacity: 0;
	}

	/* ---------- closing copyright ---------- */
	.footer__closing {
		font-family: var(--font-grotesk);
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-muted);
		opacity: 0;
	}

	@media (max-width: 768px) {
		.footer__wordmark {
			white-space: normal;
		}
	}

	/* ---------- prefers-reduced-motion: static fallback ---------- */
	@media (prefers-reduced-motion: reduce) {
		.footer {
			height: auto;
		}

		.footer__panel {
			position: static;
			height: auto;
		}

		.footer__content {
			padding-block: var(--space-section);
		}

		.footer__bg {
			position: absolute;
		}

		.footer__wordmark {
			opacity: 1;
		}

		.footer__closing {
			opacity: 1;
		}
	}
</style>

<script>
	import { scroll } from "motion";

	const wordmark = document.querySelector<HTMLElement>("[data-wordmark]");
	const closing = document.querySelector<HTMLElement>(".footer__closing");

	if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const section = document.querySelector<HTMLElement>(".footer");
		const panel = section?.querySelector<HTMLElement>(".footer__panel");
		const content = section?.querySelector<HTMLElement>(".footer__content");
		const icon = section?.querySelector<HTMLElement>(".footer__icon");
		const bg = section?.querySelector<HTMLElement>(".footer__bg");

		if (section && panel && content && icon && bg) {
			const updateHeight = () => {
				const scrollDistance = Math.max(0, content.scrollHeight - panel.clientHeight);
				section.style.height = `${100 + (scrollDistance / window.innerHeight) * 100}vh`;
			};

			updateHeight();
			window.addEventListener("resize", updateHeight);

			scroll(
				(progress: number) => {
					const maxTranslate = content.scrollHeight - panel.clientHeight;
					content.style.transform = `translateY(${-progress * maxTranslate}px)`;

					icon.style.transform = `rotate(${progress * 180}deg) translateY(${-progress * 10}px)`;

					bg.style.transform = `translateY(${-progress * maxTranslate * 0.25}px)`;

					if (wordmark || closing) {
						const fadeStart = 0.45;
						const fadeEnd = 0.95;
						const opacity = Math.max(0, Math.min(1, (progress - fadeStart) / (fadeEnd - fadeStart)));
						if (wordmark) wordmark.style.opacity = String(opacity);
						if (closing) closing.style.opacity = String(opacity);
					}
				},
				{
					target: section,
					offset: ["start start", "end end"],
				},
			);
		}
	} else {
		if (wordmark) wordmark.style.opacity = "1";
		if (closing) closing.style.opacity = "1";
	}


</script>
